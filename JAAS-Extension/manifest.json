{
    "manifest_version": 3,
    "name": "JAAS Brigde",
    "version": "3.0",
    "description": "Ponte segura de integração. Projeto in-house.",
    "content_scripts":[
        {
            "matches": ["https://*/*"],
            "js": ["scriptCatch.js"]
        },
        {
            "matches": ["https://*/*"],
            "js": ["scriptDataEntry.js"]
        }       
    ],
    "host_permissions": [
        "http://localhost:3333/*"
    ],
    "background": {
        "service_worker":"background.js"
    }
}